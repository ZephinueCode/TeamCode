{
  // ── Model Configuration ──
  // Each role can use a different provider and model independently.
  //
  // Supported providers (auto-resolve endpoint + API key env var):
  //   anthropic, openai, deepseek, openrouter, zenmux,
  //   ollama, ollama-cloud, dashscope, together, fireworks
  //
  // Or use "openai-compatible" with a custom endpoint for any provider.
  //
  // API keys are resolved from environment variables automatically:
  //   anthropic → ANTHROPIC_API_KEY
  //   deepseek  → DEEPSEEK_API_KEY
  //   openrouter → OPENROUTER_API_KEY
  //   (etc.)
  // Or set "apiKey" inline in the config.

  "models": {
    "pm": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "temperature": 0.5,
      "maxTokens": 65536
    },
    "coder": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "temperature": 0.3,
      "maxTokens": 65536
    },
    "intern": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "temperature": 0.1,
      "maxTokens": 16384
    }
  },

  // ── Example: Mix providers ──
  // "models": {
  //   "pm":    { "provider": "anthropic", "model": "claude-sonnet-4-6" },
  //   "coder": { "provider": "deepseek", "model": "deepseek-v4-pro" },
  //   "intern": { "provider": "ollama", "model": "qwen3:8b" }
  // },

  // ── Example: OpenRouter (one key, all models) ──
  // "models": {
  //   "pm":    { "provider": "openrouter", "model": "anthropic/claude-opus-4-6" },
  //   "coder": { "provider": "openrouter", "model": "deepseek/deepseek-v4-pro" },
  //   "intern": { "provider": "openrouter", "model": "google/gemini-3-flash" }
  // },

  // ── Committee Protocol ──
  "committee": {
    "deliberation": { "maxRounds": 3 },
    "execution": { "pmReview": "async", "maxReviewRounds": 2, "coderAutonomy": "full" },
    "compaction": { "auto": true, "contextLimit": 200000, "overflowRatio": 0.75 }
  },

  // ── Permissions ──
  "permission": {
    "pm": { "read": "allow", "glob": "allow", "grep": "allow", "task": "allow", "write": "deny", "edit": "deny", "shell": "deny" },
    "coder": { "*": "allow" },
    "intern": { "read": "allow", "glob": "allow", "grep": "allow", "write": "deny", "edit": "deny", "shell": "deny", "task": "deny" }
  }
}
